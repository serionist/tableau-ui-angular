{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --name-only)",
      "Bash(git diff --cached*)",
      "Bash(git diff HEAD)",
      "Bash(git diff HEAD *)",
      "Bash(git diff origin/main...HEAD*)",
      "Bash(git diff --stat origin/main...HEAD*)",
      "Bash(git diff --name-only origin/main...HEAD*)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list*)",
      "Bash(git fetch origin)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list*)",
      "Bash(gh run list*)",
      "Bash(gh run view *)",
      "Bash(npm run gate -- quick)",
      "Bash(npm run gate -- full)",
      "Bash(node tools/gate.mjs quick)",
      "Bash(node tools/gate.mjs full)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/.npmrc)",
      "Read(~/.npmrc)",
      "Read(**/testsettings.json)",
      "Read(**/.claude/settings.local.json)",
      "Bash(git diff --no-index*)",
      "Bash(git diff *--no-index*)",
      "Bash(git diff --output*)",
      "Bash(git diff *--output*)",
      "Bash(git log --output*)",
      "Bash(git log *--output*)",
      "Bash(git show --output*)",
      "Bash(git show *--output*)",
      "Bash(git blame --contents*)",
      "Bash(git blame *--contents*)",
      "Bash(git blame -S*)",
      "Bash(git blame *-S*)",
      "Bash(git blame --ignore-revs-file*)",
      "Bash(git blame *--ignore-revs-file*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git commit --no-v*)",
      "Bash(git commit *--no-v*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git push --no-v*)",
      "Bash(git push *--no-v*)"
    ]
  }
}
